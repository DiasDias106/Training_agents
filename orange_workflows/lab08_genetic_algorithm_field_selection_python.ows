	<node_properties>
		<properties node_id="0" format="literal">{'_session_items': [], '_session_items_v2': [({'type': 'AbsPath', 'path': 'datasets/agricultural_fields.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 4, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''})], 'compatibility_mode': False, 'controlAreaVisible': True, 'dialog_state': {'directory': 'datasets', 'filter': 'Text - comma separated (*.csv, *)'}, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02t\x00\x00\x00\xde\x00\x00\x03\x8b\x00\x00\x025\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024', '__version__': 3}</properties>
		<properties node_id="1" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01K\x00\x00\x00\x80\x00\x00\x04\x90\x00\x00\x02\x92\x00\x00\x01L\x00\x00\x00\x9e\x00\x00\x04\x8f\x00\x00\x02\x91\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01L\x00\x00\x00\x9e\x00\x00\x04\x8f\x00\x00\x02\x91', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': True, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="2" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'def python_script(in_data):\n\n    import random\n    import pandas as pd\n    from Orange.data import Table, Domain, StringVariable, ContinuousVariable\n\n    # ============================================================\n    # 1. CONVERTER A TABELA DO ORANGE PARA DATAFRAME\n    # ============================================================\n\n    df_num = pd.DataFrame(\n        in_data.X,\n        columns=[a.name for a in in_data.domain.attributes]\n    )\n\n    df = df_num.copy()\n\n    # Adicionar colunas de texto, como "Campo"\n    if in_data.domain.metas:\n        df_meta = pd.DataFrame(\n            in_data.metas,\n            columns=[m.name for m in in_data.domain.metas]\n        )\n        df = pd.concat([df_meta, df_num], axis=1)\n\n    # Garantir que existe a coluna Campo\n    if "Campo" not in df.columns:\n        df.insert(0, "Campo", ["C" + str(i + 1) for i in range(len(df))])\n\n    # Corrigir tipos de dados\n    df["Campo"] = df["Campo"].astype(str)\n    df["Custo"] = df["Custo"].astype(float)\n    df["Risco"] = df["Risco"].astype(float)\n    df["Prioridade"] = df["Prioridade"].astype(float)\n\n    campos = df.to_dict("records")\n\n    # ============================================================\n    # 2. PARÂMETROS DO ALGORITMO GENÉTICO\n    # ============================================================\n\n    MAX_RISK = 20\n    POP_SIZE = 100\n    GENERATIONS = 200\n    MUTATION_RATE = 0.25\n\n    # ============================================================\n    # 3. FUNÇÕES DE AVALIAÇÃO\n    # ============================================================\n\n    def total_cost(route):\n        return sum(c["Custo"] for c in route)\n\n    def total_risk(route):\n        return sum(c["Risco"] for c in route)\n\n    def priority_bonus(route):\n        bonus = 0\n\n        for c in route:\n            if c["Prioridade"] == 1:\n                bonus += 30\n            elif c["Prioridade"] == 2:\n                bonus += 15\n            else:\n                bonus += 3\n\n        return bonus\n\n    def priority_penalty(route):\n        penalty = 0\n\n        for i in range(len(route)):\n            for j in range(i + 1, len(route)):\n                if route[i]["Prioridade"] &gt; route[j]["Prioridade"]:\n                    penalty += 20\n\n        return penalty\n\n    def fitness(route):\n        cost = total_cost(route)\n        risk = total_risk(route)\n        penalty = priority_penalty(route)\n        bonus = priority_bonus(route)\n\n        if risk &gt; MAX_RISK:\n            penalty += 1000 + ((risk - MAX_RISK) * 100)\n\n        return cost + penalty - bonus\n\n    # ============================================================\n    # 4. CRIAÇÃO DA POPULAÇÃO INICIAL\n    # ============================================================\n\n    def create_individual():\n        route = campos.copy()\n        random.shuffle(route)\n\n        selected = []\n        risk = 0\n\n        for c in route:\n            if risk + c["Risco"] &lt;= MAX_RISK:\n                selected.append(c)\n                risk += c["Risco"]\n\n        return selected\n\n    # ============================================================\n    # 5. CRUZAMENTO\n    # ============================================================\n\n    def crossover(parent1, parent2):\n        child = []\n\n        for c in parent1 + parent2:\n            already_exists = False\n\n            for existing in child:\n                if existing["Campo"] == c["Campo"]:\n                    already_exists = True\n\n            if not already_exists:\n                child.append(c)\n\n        valid_child = []\n        risk = 0\n\n        for c in child:\n            if risk + c["Risco"] &lt;= MAX_RISK:\n                valid_child.append(c)\n                risk += c["Risco"]\n\n        return valid_child\n\n    # ============================================================\n    # 6. MUTAÇÃO\n    # ============================================================\n\n    def mutate(route):\n        new_route = route.copy()\n\n        if len(new_route) &gt; 1 and random.random() &lt; MUTATION_RATE:\n            i, j = random.sample(range(len(new_route)), 2)\n            new_route[i], new_route[j] = new_route[j], new_route[i]\n\n        return new_route\n\n    # ============================================================\n    # 7. EXECUÇÃO DO ALGORITMO GENÉTICO\n    # ============================================================\n\n    population = [create_individual() for _ in range(POP_SIZE)]\n\n    for generation in range(GENERATIONS):\n\n        population = sorted(population, key=fitness)\n\n        best_half = population[:POP_SIZE // 2]\n\n        new_population = best_half.copy()\n\n        while len(new_population) &lt; POP_SIZE:\n            parent1, parent2 = random.sample(best_half, 2)\n\n            child = crossover(parent1, parent2)\n            child = mutate(child)\n\n            new_population.append(child)\n\n        population = new_population\n\n    best_route = sorted(population, key=fitness)[0]\n\n    # Ordenar visualmente a rota final:\n    # primeiro prioridade, depois menor custo\n    best_route = sorted(best_route, key=lambda x: (x["Prioridade"], x["Custo"]))\n\n    # ============================================================\n    # 8. CRIAR RESULTADO FINAL\n    # ============================================================\n\n    custo_total = total_cost(best_route)\n    risco_total = total_risk(best_route)\n    fitness_final = fitness(best_route)\n\n    result = []\n\n    for ordem, c in enumerate(best_route, start=1):\n        result.append([\n            ordem,\n            c["Campo"],\n            c["Custo"],\n            c["Risco"],\n            c["Prioridade"],\n            custo_total,\n            risco_total,\n            fitness_final\n        ])\n\n    result_df = pd.DataFrame(result, columns=[\n        "Ordem",\n        "Campo",\n        "Custo",\n        "Risco",\n        "Prioridade",\n        "Custo_Total_Rota",\n        "Risco_Total_Rota",\n        "Fitness"\n    ])\n\n    # ============================================================\n    # 9. CONVERTER RESULTADO PARA TABELA DO ORANGE\n    # ============================================================\n\n    domain = Domain(\n        [\n            ContinuousVariable("Ordem"),\n            ContinuousVariable("Custo"),\n            ContinuousVariable("Risco"),\n            ContinuousVariable("Prioridade"),\n            ContinuousVariable("Custo_Total_Rota"),\n            ContinuousVariable("Risco_Total_Rota"),\n            ContinuousVariable("Fitness")\n        ],\n        metas=[\n            StringVariable("Campo")\n        ]\n    )\n\n    X = result_df[[\n        "Ordem",\n        "Custo",\n        "Risco",\n        "Prioridade",\n        "Custo_Total_Rota",\n        "Risco_Total_Rota",\n        "Fitness"\n    ]].values\n\n    metas = result_df[["Campo"]].astype(str).values\n\n    out_data = Table.from_numpy(domain, X, metas=metas)\n\n    # ============================================================\n    # 10. DEVOLVER RESULTADO AO ORANGE\n    # ============================================================\n\n    return out_data, None, None, None', 'filename': None}], 'scriptText': 'def python_script(in_data):\n\n    import random\n    import pandas as pd\n    from Orange.data import Table, Domain, StringVariable, ContinuousVariable\n\n    # ============================================================\n    # 1. CONVERTER A TABELA DO ORANGE PARA DATAFRAME\n    # ============================================================\n\n    df_num = pd.DataFrame(\n        in_data.X,\n        columns=[a.name for a in in_data.domain.attributes]\n    )\n\n    df = df_num.copy()\n\n    # Adicionar colunas de texto, como "Campo"\n    if in_data.domain.metas:\n        df_meta = pd.DataFrame(\n            in_data.metas,\n            columns=[m.name for m in in_data.domain.metas]\n        )\n        df = pd.concat([df_meta, df_num], axis=1)\n\n    # Garantir que existe a coluna Campo\n    if "Campo" not in df.columns:\n        df.insert(0, "Campo", ["C" + str(i + 1) for i in range(len(df))])\n\n    # Corrigir tipos de dados\n    df["Campo"] = df["Campo"].astype(str)\n    df["Custo"] = df["Custo"].astype(float)\n    df["Risco"] = df["Risco"].astype(float)\n    df["Prioridade"] = df["Prioridade"].astype(float)\n\n    campos = df.to_dict("records")\n\n    # ============================================================\n    # 2. PARÂMETROS DO ALGORITMO GENÉTICO\n    # ============================================================\n\n    MAX_RISK = 20\n    POP_SIZE = 100\n    GENERATIONS = 200\n    MUTATION_RATE = 0.25\n\n    # ============================================================\n    # 3. FUNÇÕES DE AVALIAÇÃO\n    # ============================================================\n\n    def total_cost(route):\n        return sum(c["Custo"] for c in route)\n\n    def total_risk(route):\n        return sum(c["Risco"] for c in route)\n\n    def priority_bonus(route):\n        bonus = 0\n\n        for c in route:\n            if c["Prioridade"] == 1:\n                bonus += 30\n            elif c["Prioridade"] == 2:\n                bonus += 15\n            else:\n                bonus += 3\n\n        return bonus\n\n    def priority_penalty(route):\n        penalty = 0\n\n        for i in range(len(route)):\n            for j in range(i + 1, len(route)):\n                if route[i]["Prioridade"] &gt; route[j]["Prioridade"]:\n                    penalty += 20\n\n        return penalty\n\n    def fitness(route):\n        cost = total_cost(route)\n        risk = total_risk(route)\n        penalty = priority_penalty(route)\n        bonus = priority_bonus(route)\n\n        if risk &gt; MAX_RISK:\n            penalty += 1000 + ((risk - MAX_RISK) * 100)\n\n        return cost + penalty - bonus\n\n    # ============================================================\n    # 4. CRIAÇÃO DA POPULAÇÃO INICIAL\n    # ============================================================\n\n    def create_individual():\n        route = campos.copy()\n        random.shuffle(route)\n\n        selected = []\n        risk = 0\n\n        for c in route:\n            if risk + c["Risco"] &lt;= MAX_RISK:\n                selected.append(c)\n                risk += c["Risco"]\n\n        return selected\n\n    # ============================================================\n    # 5. CRUZAMENTO\n    # ============================================================\n\n    def crossover(parent1, parent2):\n        child = []\n\n        for c in parent1 + parent2:\n            already_exists = False\n\n            for existing in child:\n                if existing["Campo"] == c["Campo"]:\n                    already_exists = True\n\n            if not already_exists:\n                child.append(c)\n\n        valid_child = []\n        risk = 0\n\n        for c in child:\n            if risk + c["Risco"] &lt;= MAX_RISK:\n                valid_child.append(c)\n                risk += c["Risco"]\n\n        return valid_child\n\n    # ============================================================\n    # 6. MUTAÇÃO\n    # ============================================================\n\n    def mutate(route):\n        new_route = route.copy()\n\n        if len(new_route) &gt; 1 and random.random() &lt; MUTATION_RATE:\n            i, j = random.sample(range(len(new_route)), 2)\n            new_route[i], new_route[j] = new_route[j], new_route[i]\n\n        return new_route\n\n    # ============================================================\n    # 7. EXECUÇÃO DO ALGORITMO GENÉTICO\n    # ============================================================\n\n    population = [create_individual() for _ in range(POP_SIZE)]\n\n    for generation in range(GENERATIONS):\n\n        population = sorted(population, key=fitness)\n\n        best_half = population[:POP_SIZE // 2]\n\n        new_population = best_half.copy()\n\n        while len(new_population) &lt; POP_SIZE:\n            parent1, parent2 = random.sample(best_half, 2)\n\n            child = crossover(parent1, parent2)\n            child = mutate(child)\n\n            new_population.append(child)\n\n        population = new_population\n\n    best_route = sorted(population, key=fitness)[0]\n\n    # Ordenar visualmente a rota final:\n    # primeiro prioridade, depois menor custo\n    best_route = sorted(best_route, key=lambda x: (x["Prioridade"], x["Custo"]))\n\n    # ============================================================\n    # 8. CRIAR RESULTADO FINAL\n    # ============================================================\n\n    custo_total = total_cost(best_route)\n    risco_total = total_risk(best_route)\n    fitness_final = fitness(best_route)\n\n    result = []\n\n    for ordem, c in enumerate(best_route, start=1):\n        result.append([\n            ordem,\n            c["Campo"],\n            c["Custo"],\n            c["Risco"],\n            c["Prioridade"],\n            custo_total,\n            risco_total,\n            fitness_final\n        ])\n\n    result_df = pd.DataFrame(result, columns=[\n        "Ordem",\n        "Campo",\n        "Custo",\n        "Risco",\n        "Prioridade",\n        "Custo_Total_Rota",\n        "Risco_Total_Rota",\n        "Fitness"\n    ])\n\n    # ============================================================\n    # 9. CONVERTER RESULTADO PARA TABELA DO ORANGE\n    # ============================================================\n\n    domain = Domain(\n        [\n            ContinuousVariable("Ordem"),\n            ContinuousVariable("Custo"),\n            ContinuousVariable("Risco"),\n            ContinuousVariable("Prioridade"),\n            ContinuousVariable("Custo_Total_Rota"),\n            ContinuousVariable("Risco_Total_Rota"),\n            ContinuousVariable("Fitness")\n        ],\n        metas=[\n            StringVariable("Campo")\n        ]\n    )\n\n    X = result_df[[\n        "Ordem",\n        "Custo",\n        "Risco",\n        "Prioridade",\n        "Custo_Total_Rota",\n        "Risco_Total_Rota",\n        "Fitness"\n    ]].values\n\n    metas = result_df[["Campo"]].astype(str).values\n\n    out_data = Table.from_numpy(domain, X, metas=metas)\n\n    # ============================================================\n    # 10. DEVOLVER RESULTADO AO ORANGE\n    # ============================================================\n\n    return out_data, None, None, None', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="3" format="literal">{'_session_items': [], '_session_items_v2': [({'type': 'AbsPath', 'path': 'datasets/agricultural_fields_with_coordinates.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 6, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''}), ({'type': 'AbsPath', 'path': 'datasets/agricultural_fields.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 4, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''})], 'compatibility_mode': False, 'controlAreaVisible': True, 'dialog_state': {'directory': 'datasets', 'filter': 'Text - comma separated (*.csv, *)'}, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02t\x00\x00\x00\xde\x00\x00\x03\x8b\x00\x00\x025\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024', '__version__': 3}</properties>
