		<properties node_id="5" format="pickle"></properties>
		<properties node_id="6" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01o\x00\x00\x00Z\x00\x00\x04\x90\x00\x00\x02\xb8\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import networkx as nx\nimport matplotlib.pyplot as plt\n\n# ===============================\n# 1. CRIAR GRAFOS\n# ===============================\n\nG_shortest = nx.DiGraph()   # Dijkstra, Bellman-Ford, Floyd-Warshall\nG_mst = nx.Graph()          # Prim e Kruskal\n\nfor row in in_data:\n    origem = str(row["origem"])\n    destino = str(row["destino"])\n    peso = float(row["peso"])\n    usar_para = str(row["usar_para"])\n\n    if usar_para == "mst":\n        G_mst.add_edge(origem, destino, weight=peso)\n    else:\n        G_shortest.add_edge(origem, destino, weight=peso)\n\n# ===============================\n# 2. ANALISAR PESOS NEGATIVOS\n# ===============================\n\nhas_negative = any(\n    data["weight"] &lt; 0\n    for u, v, data in G_shortest.edges(data=True)\n)\n\nprint("====================================")\nprint("ANÁLISE DO GRAFO")\nprint("====================================")\nprint("Nós no grafo de caminhos:", G_shortest.number_of_nodes())\nprint("Arestas no grafo de caminhos:", G_shortest.number_of_edges())\nprint("Existem pesos negativos?", has_negative)\n\nif has_negative:\n    algoritmo = "Bellman-Ford"\nelse:\n    algoritmo = "Dijkstra"\n\nprint("Algoritmo recomendado:", algoritmo)\n\n# ===============================\n# 3. MOSTRAR ARESTAS NEGATIVAS\n# ===============================\n\nprint("\\n====================================")\nprint("ARESTAS COM PESO NEGATIVO")\nprint("====================================")\n\nfor u, v, data in G_shortest.edges(data=True):\n    if data["weight"] &lt; 0:\n        print(u, "-&gt;", v, "| peso =", data["weight"])\n\n# ===============================\n# 4. CAMINHO MÍNIMO LISBOA -&gt; FARO\n# ===============================\n\norigem = "Lisboa"\ndestino = "Faro"\n\nprint("\\n====================================")\nprint("CAMINHO MÍNIMO:", origem, "-&gt;", destino)\nprint("====================================")\n\ncaminho_faro = None\n\ntry:\n    if algoritmo == "Bellman-Ford":\n        caminho_faro = nx.bellman_ford_path(\n            G_shortest, origem, destino, weight="weight"\n        )\n        custo_faro = nx.bellman_ford_path_length(\n            G_shortest, origem, destino, weight="weight"\n        )\n    else:\n        caminho_faro = nx.dijkstra_path(\n            G_shortest, origem, destino, weight="weight"\n        )\n        custo_faro = nx.dijkstra_path_length(\n            G_shortest, origem, destino, weight="weight"\n        )\n\n    print("Caminho:", caminho_faro)\n    print("Custo total:", custo_faro)\n\nexcept Exception as e:\n    print("Erro:", e)\n\n# ===============================\n# 5. CAMINHO MÍNIMO LISBOA -&gt; BRAGANCA\n# ===============================\n\norigem = "Lisboa"\ndestino = "Braganca"\n\nprint("\\n====================================")\nprint("CAMINHO MÍNIMO:", origem, "-&gt;", destino)\nprint("====================================")\n\ncaminho_braganca = None\n\ntry:\n    if algoritmo == "Bellman-Ford":\n        caminho_braganca = nx.bellman_ford_path(\n            G_shortest, origem, destino, weight="weight"\n        )\n        custo_braganca = nx.bellman_ford_path_length(\n            G_shortest, origem, destino, weight="weight"\n        )\n    else:\n        caminho_braganca = nx.dijkstra_path(\n            G_shortest, origem, destino, weight="weight"\n        )\n        custo_braganca = nx.dijkstra_path_length(\n            G_shortest, origem, destino, weight="weight"\n        )\n\n    print("Caminho:", caminho_braganca)\n    print("Custo total:", custo_braganca)\n\nexcept Exception as e:\n    print("Erro:", e)\n\n# ===============================\n# 6. FLOYD-WARSHALL\n# ===============================\n\nprint("\\n====================================")\nprint("FLOYD-WARSHALL")\nprint("Caminhos mínimos entre todos os pares")\nprint("====================================")\n\ntry:\n    distancias = dict(nx.floyd_warshall(G_shortest, weight="weight"))\n\n    print("Lisboa -&gt; Porto:", distancias["Lisboa"]["Porto"])\n    print("Lisboa -&gt; Faro:", distancias["Lisboa"]["Faro"])\n    print("Lisboa -&gt; Braganca:", distancias["Lisboa"]["Braganca"])\n\nexcept Exception as e:\n    print("Erro no Floyd-Warshall:", e)\n\n# ===============================\n# 7. PRIM\n# ===============================\n\nprint("\\n====================================")\nprint("PRIM")\nprint("Árvore Geradora Mínima")\nprint("====================================")\n\ntry:\n    mst_prim = nx.minimum_spanning_tree(\n        G_mst, algorithm="prim", weight="weight"\n    )\n\n    custo_prim = 0\n\n    for u, v, data in mst_prim.edges(data=True):\n        print(u, "--", v, "| peso =", data["weight"])\n        custo_prim += data["weight"]\n\n    print("Custo total Prim:", custo_prim)\n\nexcept Exception as e:\n    print("Erro no Prim:", e)\n\n# ===============================\n# 8. KRUSKAL\n# ===============================\n\nprint("\\n====================================")\nprint("KRUSKAL")\nprint("Árvore Geradora Mínima")\nprint("====================================")\n\ntry:\n    mst_kruskal = nx.minimum_spanning_tree(\n        G_mst, algorithm="kruskal", weight="weight"\n    )\n\n    custo_kruskal = 0\n\n    for u, v, data in mst_kruskal.edges(data=True):\n        print(u, "--", v, "| peso =", data["weight"])\n        custo_kruskal += data["weight"]\n\n    print("Custo total Kruskal:", custo_kruskal)\n\nexcept Exception as e:\n    print("Erro no Kruskal:", e)\n\n# ===============================\n# 9. GRÁFICO 1 — GRAFO DE CAMINHOS\n# ===============================\n\nplt.figure(figsize=(14, 10))\n\npos = nx.spring_layout(G_shortest, seed=42)\n\nnx.draw(\n    G_shortest,\n    pos,\n    with_labels=True,\n    node_color="lightblue",\n    node_size=1800,\n    font_size=8,\n    arrows=True\n)\n\nlabels = nx.get_edge_attributes(G_shortest, "weight")\n\nnx.draw_networkx_edge_labels(\n    G_shortest,\n    pos,\n    edge_labels=labels,\n    font_size=7\n)\n\nplt.title("Grafo dirigido — caminhos mínimos")\nplt.show()\n\n# ===============================\n# 10. GRÁFICO 2 — CAMINHO LISBOA -&gt; FARO\n# ===============================\n\nif caminho_faro is not None:\n\n    plt.figure(figsize=(14, 10))\n\n    nx.draw(\n        G_shortest,\n        pos,\n        with_labels=True,\n        node_color="lightgrey",\n        node_size=1800,\n        font_size=8,\n        arrows=True\n    )\n\n    edges_path = list(zip(caminho_faro, caminho_faro[1:]))\n\n    nx.draw_networkx_edges(\n        G_shortest,\n        pos,\n        edgelist=edges_path,\n        edge_color="red",\n        width=3,\n        arrows=True\n    )\n\n    nx.draw_networkx_edge_labels(\n        G_shortest,\n        pos,\n        edge_labels=labels,\n        font_size=7\n    )\n\n    plt.title("Caminho mínimo Lisboa -&gt; Faro")\n    plt.show()\n\n# ===============================\n# 11. GRÁFICO 3 — CAMINHO LISBOA -&gt; BRAGANCA\n# ===============================\n\nif caminho_braganca is not None:\n\n    plt.figure(figsize=(14, 10))\n\n    nx.draw(\n        G_shortest,\n        pos,\n        with_labels=True,\n        node_color="lightgrey",\n        node_size=1800,\n        font_size=8,\n        arrows=True\n    )\n\n    edges_path = list(zip(caminho_braganca, caminho_braganca[1:]))\n\n    nx.draw_networkx_edges(\n        G_shortest,\n        pos,\n        edgelist=edges_path,\n        edge_color="red",\n        width=3,\n        arrows=True\n    )\n\n    nx.draw_networkx_edge_labels(\n        G_shortest,\n        pos,\n        edge_labels=labels,\n        font_size=7\n    )\n\n    plt.title("Caminho mínimo Lisboa -&gt; Braganca")\n    plt.show()\n\n# ===============================\n# 12. GRÁFICO 4 — PRIM\n# ===============================\n\nplt.figure(figsize=(14, 10))\n\npos_mst = nx.spring_layout(G_mst, seed=42)\n\nnx.draw(\n    G_mst,\n    pos_mst,\n    with_labels=True,\n    node_color="lightgrey",\n    node_size=1800,\n    font_size=8\n)\n\nnx.draw_networkx_edges(\n    mst_prim,\n    pos_mst,\n    edge_color="green",\n    width=3\n)\n\nlabels_mst = nx.get_edge_attributes(G_mst, "weight")\n\nnx.draw_networkx_edge_labels(\n    G_mst,\n    pos_mst,\n    edge_labels=labels_mst,\n    font_size=7\n)\n\nplt.title("Árvore Geradora Mínima — Prim")\nplt.show()\n\n# ===============================\n# 13. GRÁFICO 5 — KRUSKAL\n# ===============================\n\nplt.figure(figsize=(14, 10))\n\nnx.draw(\n    G_mst,\n    pos_mst,\n    with_labels=True,\n    node_color="lightgrey",\n    node_size=1800,\n    font_size=8\n)\n\nnx.draw_networkx_edges(\n    mst_kruskal,\n    pos_mst,\n    edge_color="orange",\n    width=3\n)\n\nnx.draw_networkx_edge_labels(\n    G_mst,\n    pos_mst,\n    edge_labels=labels_mst,\n    font_size=7\n)\n\nplt.title("Árvore Geradora Mínima — Kruskal")\nplt.show()\n\n# ===============================\n# 14. CONCLUSÃO\n# ===============================\n\nprint("\\n====================================")\nprint("CONCLUSÃO INTELIGENTE")\nprint("====================================")\n\nprint("Caminho mínimo com pesos negativos:", algoritmo)\nprint("Caminhos mínimos entre todos os pares: Floyd-Warshall")\nprint("Rede mínima para ligar todas as cidades: Prim ou Kruskal")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="7" format="literal">{'_session_items': [], '_session_items_v2': [({'type': 'AbsPath', 'path': 'datasets/portugal_graph_negative_weights.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 9, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''})], 'compatibility_mode': False, 'controlAreaVisible': True, 'dialog_state': {'directory': 'datasets', 'filter': 'Text - comma separated (*.csv, *)'}, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02t\x00\x00\x00\xde\x00\x00\x03\x8b\x00\x00\x025\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024', '__version__': 3}</properties>
		<properties node_id="8" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import networkx as nx\nimport numpy as np\nimport pandas as pd\n\n# ===============================\n# 1. CRIAR GRAFO DIRIGIDO\n# ===============================\n\nG = nx.DiGraph()\n\nfor row in in_data:\n    origem = str(row["origem"])\n    destino = str(row["destino"])\n    peso = float(row["peso"])\n    usar_para = str(row["usar_para"])\n\n    # Só usamos os dados de caminhos mínimos\n    if usar_para != "mst":\n        G.add_edge(origem, destino, weight=peso)\n\n# ===============================\n# 2. LISTA DE NÓS\n# ===============================\n\nnodes = list(G.nodes())\n\nprint("====================================")\nprint("NÓS DO GRAFO")\nprint("====================================")\nprint(nodes)\n\n# ===============================\n# 3. MATRIZ DE ADJACÊNCIA SIMPLES\n# ===============================\n\nadj_matrix = nx.to_numpy_array(\n    G,\n    nodelist=nodes,\n    weight="weight",\n    nonedge=0\n)\n\ndf_adj = pd.DataFrame(\n    adj_matrix,\n    index=nodes,\n    columns=nodes\n)\n\nprint("\\n====================================")\nprint("MATRIZ DE ADJACÊNCIA")\nprint("0 significa: sem ligação")\nprint("====================================")\nprint(df_adj)\n\n# ===============================\n# 4. MATRIZ PARA FLOYD-WARSHALL\n# ===============================\n# Regra:\n# diagonal = 0\n# ligação existente = peso\n# sem ligação = infinito\n\nfw_matrix = nx.to_numpy_array(\n    G,\n    nodelist=nodes,\n    weight="weight",\n    nonedge=np.inf\n)\n\nnp.fill_diagonal(fw_matrix, 0)\n\ndf_fw_initial = pd.DataFrame(\n    fw_matrix,\n    index=nodes,\n    columns=nodes\n)\n\nprint("\\n====================================")\nprint("MATRIZ INICIAL D0 PARA FLOYD-WARSHALL")\nprint("inf significa: não existe ligação direta")\nprint("====================================")\nprint(df_fw_initial)\n\n# ===============================\n# 5. APLICAR FLOYD-WARSHALL MANUALMENTE\n# ===============================\n\nD = fw_matrix.copy()\nn = len(nodes)\n\nprint("\\n====================================")\nprint("ITERAÇÕES DO FLOYD-WARSHALL")\nprint("====================================")\n\nfor k in range(n):\n    intermediario = nodes[k]\n\n    print("\\nA considerar o nó intermédio:", intermediario)\n\n    for i in range(n):\n        for j in range(n):\n            if D[i][k] + D[k][j] &lt; D[i][j]:\n                print(\n                    "Melhorou:",\n                    nodes[i], "-&gt;", nodes[j],\n                    "| antes =", D[i][j],\n                    "| novo =", D[i][k] + D[k][j],\n                    "| via", intermediario\n                )\n\n                D[i][j] = D[i][k] + D[k][j]\n\n# ===============================\n# 6. MATRIZ FINAL\n# ===============================\n\ndf_fw_final = pd.DataFrame(\n    D,\n    index=nodes,\n    columns=nodes\n)\n\nprint("\\n====================================")\nprint("MATRIZ FINAL DO FLOYD-WARSHALL")\nprint("Menor distância entre todos os pares")\nprint("====================================")\nprint(df_fw_final)\n\n# ===============================\n# 7. COMPARAÇÃO DE ALGUNS CAMINHOS\n# ===============================\n\nprint("\\n====================================")\nprint("EXEMPLOS DE RESULTADOS")\nprint("====================================")\n\npares = [\n    ("Lisboa", "Porto"),\n    ("Lisboa", "Faro"),\n    ("Lisboa", "Braganca"),\n    ("Coimbra", "Porto"),\n    ("Faro", "Evora")\n]\n\nfor origem, destino in pares:\n    if origem in nodes and destino in nodes:\n        i = nodes.index(origem)\n        j = nodes.index(destino)\n\n        print(\n            origem, "-&gt;", destino,\n            "| distância mínima =", D[i][j]\n        )\n\n# ===============================\n# 8. DETETAR PESOS NEGATIVOS\n# ===============================\n\nprint("\\n====================================")\nprint("PESOS NEGATIVOS")\nprint("====================================")\n\ntem_negativos = False\n\nfor u, v, data in G.edges(data=True):\n    if data["weight"] &lt; 0:\n        tem_negativos = True\n        print(u, "-&gt;", v, "| peso =", data["weight"])\n\nif tem_negativos:\n    print("\\nConclusão: existem pesos negativos.")\n    print("Para origem única, deve usar Bellman-Ford.")\nelse:\n    print("\\nConclusão: não existem pesos negativos.")\n    print("Para origem única, pode usar Dijkstra.")\n\nprint("\\nPara todos os pares, usa-se Floyd-Warshall.")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="9" format="literal">{'_session_items': [], '_session_items_v2': [({'type': 'AbsPath', 'path': 'datasets/portugal_graph_negative_weights.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 9, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''})], 'compatibility_mode': False, 'controlAreaVisible': True, 'dialog_state': {'directory': 'datasets', 'filter': 'Text - comma separated (*.csv, *)'}, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02t\x00\x00\x00\xde\x00\x00\x03\x8b\x00\x00\x025\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024', '__version__': 3}</properties>
		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01o\x00\x00\x00Z\x00\x00\x04\x90\x00\x00\x02\xb8\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import networkx as nx\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport time\n\n# ===============================\n# 1. CRIAR GRAFO\n# ===============================\n\nG = nx.DiGraph()\n\nfor row in in_data:\n    origem = str(row["origem"])\n    destino = str(row["destino"])\n    peso = float(row["peso"])\n    usar_para = str(row["usar_para"])\n\n    if usar_para != "mst":\n        G.add_edge(origem, destino, weight=peso)\n\nnodes = list(G.nodes())\nn = len(nodes)\n\n# ===============================\n# 2. MATRIZ INICIAL\n# ===============================\n\nD = nx.to_numpy_array(\n    G,\n    nodelist=nodes,\n    weight="weight",\n    nonedge=np.inf\n)\n\nnp.fill_diagonal(D, 0)\n\nprint("Nós:", nodes)\n\n# ===============================\n# 3. FUNÇÃO PARA DESENHAR MATRIZ\n# ===============================\n\ndef show_matrix(matrix, title):\n    display_matrix = matrix.copy()\n\n    # Substituir infinito por valor grande só para desenhar\n    temp = display_matrix.copy()\n    temp[np.isinf(temp)] = np.nan\n\n    plt.figure(figsize=(10, 8))\n    plt.imshow(temp, aspect="auto")\n    plt.colorbar(label="Distância mínima")\n\n    plt.xticks(range(n), nodes, rotation=90)\n    plt.yticks(range(n), nodes)\n\n    for i in range(n):\n        for j in range(n):\n            value = matrix[i][j]\n\n            if np.isinf(value):\n                text = "∞"\n            else:\n                text = str(int(value))\n\n            plt.text(j, i, text, ha="center", va="center")\n\n    plt.title(title)\n    plt.tight_layout()\n    plt.show()\n\n# ===============================\n# 4. MOSTRAR MATRIZ INICIAL\n# ===============================\n\nshow_matrix(D, "Matriz inicial D0 — Floyd-Warshall")\n\n# ===============================\n# 5. ANIMAÇÃO DO FLOYD-WARSHALL\n# ===============================\n\nfor k in range(n):\n    intermediario = nodes[k]\n\n    houve_melhoria = False\n\n    print("\\n====================================")\n    print("Iteração k =", k)\n    print("Nó intermédio:", intermediario)\n    print("====================================")\n\n    for i in range(n):\n        for j in range(n):\n\n            if D[i][k] + D[k][j] &lt; D[i][j]:\n\n                print(\n                    "Melhorou:",\n                    nodes[i], "-&gt;", nodes[j],\n                    "| antes =", D[i][j],\n                    "| novo =", D[i][k] + D[k][j],\n                    "| via", intermediario\n                )\n\n                D[i][j] = D[i][k] + D[k][j]\n                houve_melhoria = True\n\n    if houve_melhoria:\n        show_matrix(\n            D,\n            "Floyd-Warshall | usando " + intermediario + " como nó intermédio"\n        )\n        time.sleep(1)\n    else:\n        print("Não houve melhorias nesta iteração.")\n\n# ===============================\n# 6. MATRIZ FINAL\n# ===============================\n\nshow_matrix(D, "Matriz final — menores distâncias entre todos os pares")\n\ndf_final = pd.DataFrame(D, index=nodes, columns=nodes)\n\nprint("\\n====================================")\nprint("MATRIZ FINAL")\nprint("====================================")\nprint(df_final)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="11" format="literal">{'_session_items': [], '_session_items_v2': [({'type': 'AbsPath', 'path': 'datasets/portugal_graph_negative_weights.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 9, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''})], 'compatibility_mode': False, 'controlAreaVisible': True, 'dialog_state': {'directory': 'datasets', 'filter': 'Text - comma separated (*.csv, *)'}, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02t\x00\x00\x00\xde\x00\x00\x03\x8b\x00\x00\x025\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x02u\x00\x00\x00\xfc\x00\x00\x03\x8a\x00\x00\x024', '__version__': 3}</properties>
		<properties node_id="12" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import networkx as nx\nimport numpy as np\nimport pandas as pd\n\n# ===============================\n# 1. CRIAR GRAFO DIRIGIDO\n# ===============================\n\nG = nx.DiGraph()\n\nfor row in in_data:\n    origem = str(row["origem"])\n    destino = str(row["destino"])\n    peso = float(row["peso"])\n    usar_para = str(row["usar_para"])\n\n    # Só usamos os dados de caminhos mínimos\n    if usar_para != "mst":\n        G.add_edge(origem, destino, weight=peso)\n\n# ===============================\n# 2. LISTA DE NÓS\n# ===============================\n\nnodes = list(G.nodes())\n\nprint("====================================")\nprint("NÓS DO GRAFO")\nprint("====================================")\nprint(nodes)\n\n# ===============================\n# 3. MATRIZ DE ADJACÊNCIA SIMPLES\n# ===============================\n\nadj_matrix = nx.to_numpy_array(\n    G,\n    nodelist=nodes,\n    weight="weight",\n    nonedge=0\n)\n\ndf_adj = pd.DataFrame(\n    adj_matrix,\n    index=nodes,\n    columns=nodes\n)\n\nprint("\\n====================================")\nprint("MATRIZ DE ADJACÊNCIA")\nprint("0 significa: sem ligação")\nprint("====================================")\nprint(df_adj)\n\n# ===============================\n# 4. MATRIZ PARA FLOYD-WARSHALL\n# ===============================\n# Regra:\n# diagonal = 0\n# ligação existente = peso\n# sem ligação = infinito\n\nfw_matrix = nx.to_numpy_array(\n    G,\n    nodelist=nodes,\n    weight="weight",\n    nonedge=np.inf\n)\n\nnp.fill_diagonal(fw_matrix, 0)\n\ndf_fw_initial = pd.DataFrame(\n    fw_matrix,\n    index=nodes,\n    columns=nodes\n)\n\nprint("\\n====================================")\nprint("MATRIZ INICIAL D0 PARA FLOYD-WARSHALL")\nprint("inf significa: não existe ligação direta")\nprint("====================================")\nprint(df_fw_initial)\n\n# ===============================\n# 5. APLICAR FLOYD-WARSHALL MANUALMENTE\n# ===============================\n\nD = fw_matrix.copy()\nn = len(nodes)\n\nprint("\\n====================================")\nprint("ITERAÇÕES DO FLOYD-WARSHALL")\nprint("====================================")\n\nfor k in range(n):\n    intermediario = nodes[k]\n\n    print("\\nA considerar o nó intermédio:", intermediario)\n\n    for i in range(n):\n        for j in range(n):\n            if D[i][k] + D[k][j] &lt; D[i][j]:\n                print(\n                    "Melhorou:",\n                    nodes[i], "-&gt;", nodes[j],\n                    "| antes =", D[i][j],\n                    "| novo =", D[i][k] + D[k][j],\n                    "| via", intermediario\n                )\n\n                D[i][j] = D[i][k] + D[k][j]\n\n# ===============================\n# 6. MATRIZ FINAL\n# ===============================\n\ndf_fw_final = pd.DataFrame(\n    D,\n    index=nodes,\n    columns=nodes\n)\n\nprint("\\n====================================")\nprint("MATRIZ FINAL DO FLOYD-WARSHALL")\nprint("Menor distância entre todos os pares")\nprint("====================================")\nprint(df_fw_final)\n\n# ===============================\n# 7. COMPARAÇÃO DE ALGUNS CAMINHOS\n# ===============================\n\nprint("\\n====================================")\nprint("EXEMPLOS DE RESULTADOS")\nprint("====================================")\n\npares = [\n    ("Lisboa", "Porto"),\n    ("Lisboa", "Faro"),\n    ("Lisboa", "Braganca"),\n    ("Coimbra", "Porto"),\n    ("Faro", "Evora")\n]\n\nfor origem, destino in pares:\n    if origem in nodes and destino in nodes:\n        i = nodes.index(origem)\n        j = nodes.index(destino)\n\n        print(\n            origem, "-&gt;", destino,\n            "| distância mínima =", D[i][j]\n        )\n\n# ===============================\n# 8. DETETAR PESOS NEGATIVOS\n# ===============================\n\nprint("\\n====================================")\nprint("PESOS NEGATIVOS")\nprint("====================================")\n\ntem_negativos = False\n\nfor u, v, data in G.edges(data=True):\n    if data["weight"] &lt; 0:\n        tem_negativos = True\n        print(u, "-&gt;", v, "| peso =", data["weight"])\n\nif tem_negativos:\n    print("\\nConclusão: existem pesos negativos.")\n    print("Para origem única, deve usar Bellman-Ford.")\nelse:\n    print("\\nConclusão: não existem pesos negativos.")\n    print("Para origem única, pode usar Dijkstra.")\n\nprint("\\nPara todos os pares, usa-se Floyd-Warshall.")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
